<%
  // "Approved documents" of a Board Resolution — part of the Upload
  // Document page (v91, v92). All are saved with the page's one button:
  //   ＋ File              files from this computer         (attFiles + attTitle/attType/attRef)
  //   ＋ Google Drive      files picked in Google Drive     (driveId + accessToken, same rows)
  //   ＋ From the archive  documents already archived       (approvedDocId)
  //   picks: { others }, exclude: [ids already attached], resDocId (adding to an
  //   archived resolution) or null (new upload: uses #uploadedFile), hint (title)
  const _ap = (typeof picks !== 'undefined' && picks) ? picks : { others: [] };
  const _ex = new Set((typeof exclude !== 'undefined' && exclude) ? exclude : []);
  const _avail = (_ap.others || []).filter(x => !_ex.has(x.document_id));
  const _nmA = x => (x.category ? x.category + ': ' : '') + x.title;
  const _drive = typeof drivePicker !== 'undefined' && drivePicker;
  const _resId = typeof resDocId !== 'undefined' && resDocId ? resDocId : '';
  const _hint = typeof hint !== 'undefined' && hint ? hint : '';
  const _types = ['Manual', 'Policy', 'Memorandum', 'Other'];
%>
<div class="apd" id="apd" data-res="<%= _resId %>" data-hint="<%= _hint %>">
  <div class="apd-btns">
    <label class="btn btn-light btn-sm apd-btn" title="From this computer">
      <svg class="icon icon-sm"><use href="#i-upload" xlink:href="#i-upload"/></svg> File
      <input type="file" name="attFiles" id="apdFiles" accept=".pdf,.jpg,.jpeg,.png" multiple hidden>
    </label>
    <% if (_drive) { %>
      <button type="button" class="btn btn-light btn-sm apd-btn" id="apdDriveBtn">
        <svg viewBox="0 0 87.3 78" width="15" height="13" aria-hidden="true"><path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/><path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="#00ac47"/><path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/><path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/><path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/><path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/></svg>
        Google Drive
      </button>
      <input type="hidden" name="accessToken" id="apdDriveToken" value="">
      <div id="apdDriveIds" hidden></div>
    <% } %>
    <% if (_avail.length) { %>
      <button type="button" class="btn btn-light btn-sm apd-btn" id="apdArchBtn" aria-expanded="false">
        <svg class="icon icon-sm"><use href="#i-folder" xlink:href="#i-folder"/></svg> From the archive
      </button>
    <% } %>
  </div>
  <div class="apd-msg" id="apdMsg" hidden></div>

  <% if (_avail.length) { %>
  <div class="apd-panel" id="apdArch" hidden>
    <input type="search" class="apd-filter" id="apdFilter" placeholder="Search" aria-label="Search the archive">
    <div class="apd-list" id="apdList">
      <% let _y = null; _avail.forEach(function (x) { if (x.doc_year !== _y) { _y = x.doc_year; %><div class="apd-year"><%= x.doc_year %></div><% } %>
        <label class="apd-item"><input type="checkbox" name="approvedDocId" value="<%= x.document_id %>"> <span><%= _nmA(x) %> <span class="muted">(<%= x.doc_type %>)</span></span></label>
      <% }) %>
    </div>
  </div>
  <% } %>

  <div class="apd-rows" id="apdRows"></div>
</div>
<style>
  .apd { display: flex; flex-direction: column; gap: 10px; }
  .apd-btns { display: flex; gap: 8px; flex-wrap: wrap; }
  .apd .apd-btn { display: inline-flex; align-items: center; gap: 6px; margin: 0; cursor: pointer; font-size: 12.5px; font-weight: 600; color: var(--dark); }
  .apd .apd-btn[aria-expanded="true"] { background: #eef2fb; border-color: #c9d4ec; }
  .apd-msg { font-size: 12.5px; color: var(--red); }
  .apd-panel { border: 1px solid #e3e7f0; border-radius: 8px; padding: 10px; background: #fbfcfe; }
  .apd-rows { display: flex; flex-direction: column; gap: 10px; }
  .apd-rows:empty { display: none; }
  .apd-file { border: 1px solid #e3e7f0; border-radius: 8px; padding: 10px; background: #fff; }
  .apd-file-name { font-size: 12px; font-weight: 700; color: #0d1f45; margin-bottom: 6px; word-break: break-word; }
  .apd-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 10px; }
  .apd-grid4 { display: grid; grid-template-columns: 90px 90px 2fr 1fr; gap: 10px; }
  .apd-grid .fg, .apd-grid4 .fg { margin-bottom: 0; }
  .apd-tag { display: inline-block; font-size: 10.5px; font-weight: 700; color: #475569; background: #eef1f6; border-radius: 10px; padding: 1px 8px; margin-right: 4px; }
  .apd-tag-d { color: #1a73e8; background: #e8f0fe; }
  .apd-tag-p { color: #8a5a00; background: #fdf1d8; }
  .apd-tag-a { color: #1a8f5c; background: #dff5ed; }
  .apd-of { font-weight: 400; color: var(--muted); }
  .apd-x { border: 0; background: none; color: #94a3b8; font-size: 17px; line-height: 1; cursor: pointer; padding: 0 4px; float: right; }
  .apd-x:hover { color: #c0392b; }
  .apd-filter { width: 100%; margin-bottom: 6px; padding: 8px 12px; border: 1px solid #e3e7f0; border-radius: 8px; font: inherit; font-size: 13px; background: #fff; }
  .apd-list { max-height: 240px; overflow: auto; border: 1px solid #e3e7f0; border-radius: 8px; padding: 4px 0; background: #fff; }
  .apd-list:empty::after { content: '—'; display: block; padding: 8px 10px; color: var(--muted); font-size: 12.5px; }
  .apd-year { font-size: 11px; font-weight: 700; color: #94a3b8; padding: 6px 10px 2px; text-transform: uppercase; letter-spacing: .04em; }
  .fg .apd-item, .apd-item { display: flex; gap: 8px; align-items: flex-start; padding: 6px 10px; font-size: 12.5px; line-height: 1.4; cursor: pointer; font-weight: 400; color: #334155; margin: 0; }
  .apd-item:hover { background: #f8fafc; }
  .apd-item input { margin-top: 2px; flex: 0 0 auto; width: auto; }
  .apd-ag { display: flex; justify-content: space-between; align-items: center; gap: 10px; width: 100%; text-align: left; border: 0; background: none; font: inherit; }
  .apd-ag .apd-ag-add { flex: 0 0 auto; font-weight: 700; color: #007be8; font-size: 12px; }
  .apd-ag.is-added .apd-ag-add { color: var(--muted); }
  .apd-ag .apd-star { color: #c8922a; font-weight: 700; margin-right: 4px; }
  @media (max-width: 700px) { .apd-grid, .apd-grid4 { grid-template-columns: 1fr 1fr; } .apd-grid .fg:first-child, .apd-grid4 .fg:nth-child(3) { grid-column: 1 / -1; } }
</style>
<script>
(function () {
  var box = document.getElementById('apd'); if (!box) return;
  var msg = document.getElementById('apdMsg');
  function say(t) { msg.textContent = t || ''; msg.hidden = !t; }
  function esc(t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function noEnter(el) { if (el) el.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); }); }
  function toggle(btnId, panelId, onOpen) {
    var b = document.getElementById(btnId), p = document.getElementById(panelId); if (!b || !p) return;
    b.addEventListener('click', function () { var open = p.hidden; p.hidden = !open; b.setAttribute('aria-expanded', String(open)); if (open && onOpen) onOpen(); });
  }

  // ── From the archive: tick list ──
  var f = document.getElementById('apdFilter'), list = document.getElementById('apdList');
  noEnter(f);
  if (f) f.addEventListener('input', function () {
    var q = f.value.toLowerCase().trim();
    list.querySelectorAll('.apd-item').forEach(function (it) { it.style.display = !q || it.textContent.toLowerCase().indexOf(q) >= 0 ? '' : 'none'; });
  });
  toggle('apdArchBtn', 'apdArch');

  // ── Files from this computer and Google Drive ──
  var files = document.getElementById('apdFiles'), rows = document.getElementById('apdRows');
  var driveFiles = [], localList = [], kept = {};
  window.boardlinkApprovedDrive = function (picked) {
    picked.forEach(function (d) { if (!driveFiles.some(function (x) { return x.id === d.id; })) driveFiles.push(d); });
    render();
  };
  function row(i, name, fromDrive, key) {
    var base = name.replace(/\.[a-z0-9]{2,5}$/i, '').replace(/_+/g, ' ');
    var guess = /policy/i.test(base) ? 'Policy' : /memo/i.test(base) ? 'Memorandum' : /annex/i.test(base) ? 'Other' : 'Manual';
    var k = kept[key] || {};
    var d = document.createElement('div'); d.className = 'apd-file'; d.dataset.key = key;
    d.innerHTML = '<div class="apd-file-name"><span class="apd-tag' + (fromDrive ? ' apd-tag-d">Google Drive' : '">File') + '</span> ' + esc(name) +
      ' <button type="button" class="apd-x" data-key="' + esc(key) + '" title="Remove">&times;</button></div>' +
      '<div class="apd-grid"><div class="fg"><label>Title *</label><input name="attTitle" maxlength="255" required value="' + esc(k.title || base) + '"></div>' +
      '<div class="fg"><label>Type</label><select name="attType">' + <%- JSON.stringify(_types) %>.map(function (t) { return '<option' + (t === (k.type || guess) ? ' selected' : '') + '>' + t + '</option>'; }).join('') + '</select></div>' +
      '<div class="fg"><label>Reference No.</label><input name="attRef" maxlength="100" value="' + esc(k.ref || '') + '"></div></div>';
    return d;
  }
  function remember() {
    rows.querySelectorAll('.apd-file').forEach(function (d) {
      kept[d.dataset.key] = { title: d.querySelector('[name=attTitle]').value, type: d.querySelector('[name=attType]').value, ref: d.querySelector('[name=attRef]').value };
    });
  }
  function syncInput() { try { var dt = new DataTransfer(); localList.forEach(function (x) { dt.items.add(x); }); files.files = dt.files; } catch (_) { /* old browser */ } }
  function render() {
    remember(); rows.innerHTML = '';
    localList.slice(0, 20).forEach(function (x, i) { rows.appendChild(row(i, x.name, false, 'c:' + x.name + ':' + x.size)); });
    driveFiles.slice(0, Math.max(0, 20 - localList.length)).forEach(function (x, j) { rows.appendChild(row(localList.length + j, x.name, true, 'g:' + x.id)); });
    var ids = document.getElementById('apdDriveIds');
    if (ids) ids.innerHTML = driveFiles.map(function (x) { return '<input type="hidden" name="driveId" value="' + esc(x.id) + '">'; }).join('');
  }
  files.addEventListener('change', function () {
    Array.prototype.forEach.call(files.files, function (x) { if (!localList.some(function (y) { return y.name === x.name && y.size === x.size; })) localList.push(x); });
    syncInput(); render();
  });
  rows.addEventListener('click', function (e) {
    var x = e.target.closest('.apd-x'); if (!x) return;
    var key = x.dataset.key;
    if (key.indexOf('g:') === 0) driveFiles = driveFiles.filter(function (y) { return 'g:' + y.id !== key; });
    else localList = localList.filter(function (y) { return 'c:' + y.name + ':' + y.size !== key; });
    delete kept[key]; syncInput(); render();
  });

  // Something chosen? (used by the "add to an archived resolution" page)
  window.boardlinkApprovedCount = function () {
    return box.querySelectorAll('.apd-file').length + box.querySelectorAll('input[name=approvedDocId]:checked').length;
  };
})();
</script>
<% if (_drive) { %>
<script>
/* "Add from Google Drive" for approved documents: Google's own picker,
   several files at once. BOARDLINK may see ONLY the picked files
   (drive.file permission); they are copied in when the form is saved. */
(function () {
  var CFG = <%- JSON.stringify(drivePicker) %>;
  var btn = document.getElementById('apdDriveBtn'), tok = document.getElementById('apdDriveToken');
  if (!btn) return;
  var token = null, tokenClient = null, pickerReady = false;
  function load(src, cb) {
    if (document.querySelector('script[src="' + src + '"]')) { cb(); return; }
    var s = document.createElement('script'); s.src = src; s.async = true; s.onload = cb;
    s.onerror = function () { btn.disabled = false; alert('Google Drive could not be reached. Check the internet connection.'); }; document.head.appendChild(s);
  }
  function openPicker() {
    var view = new google.picker.DocsView(google.picker.ViewId.DOCS)
      .setMimeTypes('application/pdf,image/jpeg,image/png,application/vnd.google-apps.document,application/vnd.openxmlformats-officedocument.wordprocessingml.document')
      .setIncludeFolders(true).setSelectFolderEnabled(false);
    var b = new google.picker.PickerBuilder().addView(view).setOAuthToken(token).setDeveloperKey(CFG.apiKey)
      .enableFeature(google.picker.Feature.MULTISELECT_ENABLED)
      .setTitle('Choose the approved documents (you can pick several)').setCallback(picked);
    if (CFG.appId) b.setAppId(CFG.appId);
    b.build().setVisible(true);
  }
  function picked(data) {
    if (data.action !== google.picker.Action.PICKED || !data.docs || !data.docs.length) return;
    tok.value = token;
    window.boardlinkApprovedDrive(data.docs.map(function (d) { return { id: d.id, name: d.name }; }));
  }
  btn.addEventListener('click', function () {
    btn.disabled = true;
    var go = function () { btn.disabled = false; if (token) openPicker(); else tokenClient.requestAccessToken({ prompt: '' }); };
    if (tokenClient && pickerReady) return go();
    load('https://accounts.google.com/gsi/client', function () {
      tokenClient = google.accounts.oauth2.initTokenClient({
        client_id: CFG.clientId, scope: 'https://www.googleapis.com/auth/drive.file',
        callback: function (r) { if (r && r.access_token) { token = r.access_token; openPicker(); } }
      });
      load('https://apis.google.com/js/api.js', function () {
        gapi.load('picker', function () { pickerReady = true; go(); });
      });
    });
  });
})();
</script>
<% } %>
