# ============================================================
# BOARDLINK — Environment Variables (template)
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ============================================================

# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Session (Chapter 3 Sec. 3.6 — express-session)
SESSION_SECRET=change-me-to-a-long-random-string

# MySQL (Chapter 3 Sec. 3.4 — MySQL 8.0 + mysql2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boardlink

# whisper.cpp (Chapter 3 Sec. 3.6 — Module 7 local transcription)
# Path to the whisper.cpp binary. Leave as 'whisper' if the binary
# is on PATH. On a CSPC server, point this to the installed location
# (e.g. /opt/whisper.cpp/main).
WHISPER_BIN=whisper
WHISPER_MODEL=models/ggml-base.en.bin
WHISPER_LANG=en

# Ollama (Chapter 3 Sec. 3.6 — Module 8 summary + Module 2.3 briefing)
# Ollama runs as a local HTTP service. Install and start it first
# with:  curl -fsSL https://ollama.com/install.sh | sh
# Then pull the model:  ollama pull llama3.1:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Context window requested for every AI call. Ollama's own default is
# small and silently drops text that does not fit. 8192 suits the
# pre-meeting briefing; lower it only if the server runs out of memory.
OLLAMA_NUM_CTX=8192
# Longest single AI call before it is abandoned (ms).
OLLAMA_TIMEOUT_MS=900000
# Pre-meeting briefing: characters of a document read per AI call
# (long documents are read in parts), and how long to wait for
# scanned pages to finish OCR before summarising anyway (ms).
BRIEFING_CHUNK_CHARS=12000
# How long documents are summarised:
#   fast      (default) the key passages are picked out word for word
#             and the AI reads them in ONE request (about 5x faster)
#   thorough  the AI reads every part in turn (slower, reads everything)
BRIEFING_MODE=fast
# Characters of key passages the AI reads in fast mode.
BRIEFING_FAST_CHARS=9000
# Summarise a document automatically as soon as it is uploaded, so it
# is ready before members open it (1 = yes, 0 = only when asked).
AUTO_SUMMARY=1
BRIEFING_WAIT_OCR_MS=1200000

# Meilisearch (Chapter 3 Sec. 3.6 — Module 4)
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=

# ── Deployment (added for public/LAN hosting) ───────────────
# Set to 'production' when deployed. This enables secure cookies
# and HSTS, and makes the app REFUSE to start on the default
# SESSION_SECRET below.
# NODE_ENV=production

# Number of reverse-proxy hops to trust (Caddy/nginx = 1).
# Set to 'false' to disable entirely when running with no proxy.
TRUST_PROXY=1

# Backups (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETAIN_DAYS=30

# OCR tuning (Chapter 3 Sec. 3.6 — Module 2.4)
# Pages read for upload autofill. 1 is enough: the resolution
# number, title and year are all on the first page.
OCR_AUTOFILL_PAGES=1
# PDF render scale; 2.0 ~= 300 DPI, Tesseract's sweet spot.
OCR_RENDER_SCALE=2.0
# Path to bundled language data. Keeps OCR fully offline.
TESSDATA_PATH=./tessdata
OCR_TIMEOUT_MS=120000
LLM_TIMEOUT_MS=60000

# Maximum upload sizes (megabytes)
# Scanned documents for OCR (Digital Archive, OCR module).
MAX_UPLOAD_MB=100

# How long a member may open an archived agenda item (days) or a Board
# Resolution / document (hours) after the Board Secretary approves a request.
AGENDA_ACCESS_DAYS=7
DOCUMENT_ACCESS_HOURS=24

# Meeting audio for AI transcription.
MAX_AUDIO_UPLOAD_MB=200

# Agenda item PDFs
# Most PDFs one meeting may carry (one per agenda item).
MAX_ITEM_FILES=80
# Scanned pages read by OCR per document (to bound server time).
ITEM_OCR_MAX_PAGES=60
# A page with fewer visible characters than this counts as scanned.
ITEM_PDF_MIN_TEXT_CHARS=20
# Time zone used for dates in the compiled comments documents.
APP_TIMEZONE=Asia/Manila

# Editing an agenda document's words in Word (Board Secretary only).
# Needs two programs on the computer that RUNS BOARDLINK:
#   Ubuntu:  sudo apt install libreoffice-writer python3-pip
#            sudo pip3 install pdf2docx --break-system-packages
#   Windows: install LibreOffice and Python (tick "Add python.exe to
#            PATH"), then in Command Prompt:  pip install pdf2docx
# Leave the two settings below EMPTY: BOARDLINK finds both programs by
# itself, including LibreOffice's usual place on Windows. Fill one in
# only if a program was installed somewhere unusual, e.g.
#   SOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
PDF2WORD_PYTHON=
SOFFICE_BIN=
# How long one conversion may take before it is given up on.
WORD_CONVERT_TIMEOUT_MS=180000

# ── Sign-up and "Forgot password?" e-mails (v56) ────────────────
# BOARDLINK e-mails a 6-digit code through a Gmail account.
#  1. Use (or make) a Gmail account for BOARDLINK, e.g. boardlink.cspc@gmail.com
#  2. Turn on 2-Step Verification for it: myaccount.google.com > Security
#  3. Make an App Password: myaccount.google.com/apppasswords  (16 letters)
# While these are empty (and NODE_ENV is not production) the code is
# printed in the BOARDLINK terminal instead, for testing.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=BOARDLINK <boardlink.cspc@gmail.com>
# Which e-mail addresses may sign up (comma-separated domains).
SIGNUP_EMAIL_DOMAINS=gmail.com

# ── "Sign in with Google" (v56) ─────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > Create
# credentials > OAuth client ID > Web application. Add this exact
# Authorised redirect URI:  http://127.0.0.1:3000/auth/google/callback
# (and the real address later, e.g. https://boardlink.cspc.edu.ph/auth/google/callback)
# The Google buttons appear only when both are filled in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ── Google Drive (v57) ─────────────────────────────────────────
# Uses the same Client ID/Secret. In Google Cloud also turn on the
# "Google Drive API" and "Google Picker API", and add this redirect URI:
#   http://127.0.0.1:3000/settings/drive/callback
# "Add from Google Drive" on the archive upload page also needs an API key
# (Credentials > Create credentials > API key):
GOOGLE_API_KEY=
# Optional: the project number (Cloud Console home page), used by the picker.
# GOOGLE_PROJECT_NUMBER=
# Backup: the System Administrator connects the Drive once, in BOARDLINK
# under "Google Drive Backup".
# GOOGLE_REDIRECT_URL=http://127.0.0.1:3000/auth/google/callback

# ── Meeting recordings: video or audio (v58) ───────────────────
# Largest video/audio a meeting recording may be, in MB. Phone videos
# are about 100 MB per minute at 1080p, so the default is 1 GB.
MAX_VIDEO_UPLOAD_MB=1024
# ffmpeg reads videos and makes them playable in every browser. Leave
# empty if "ffmpeg" works in a terminal; otherwise give the full path:
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BIN=C:/ffmpeg/bin/ffprobe.exe

# Where uploaded files (agenda PDFs/Word files, videos, archived documents)
# are kept. Leave empty to use the "uploads" folder inside BOARDLINK.
# Set it to a folder OUTSIDE the BOARDLINK folder so the files are kept
# when a new BOARDLINK version is unzipped into a new folder:
# UPLOAD_DIR=C:/BOARDLINK-files
UPLOAD_DIR=
