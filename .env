# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Session
# Do NOT change this: the Google Drive backup connection is locked with it.
SESSION_SECRET=boardlink-cspc-2026-defense-bvgQ8mRzPxLn4tH7Y2K9wEaUJsVcF3

# MySQL — adjust DB_PASSWORD if your XAMPP MySQL has a root password set
# (default XAMPP install has empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boardlink

# whisper.cpp — local transcription (Module 7)
# Path uses forward slashes to avoid backslash escape issues in .env files
WHISPER_BIN=C:/Users/Cedrick/Downloads/boardlink_v3.1/tools/Release/whisper-cli.exe
WHISPER_MODEL=C:/Users/Cedrick/Downloads/boardlink_v3.1/tools/models/ggml-base.en.bin
WHISPER_LANG=en

# Ollama — local LLM (Module 2.3 briefing + Module 8 summary)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Meilisearch — local document search (Module 4)
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=

# Editing an agenda document's words in Word (Board Secretary only).
# Needs two programs on the computer that RUNS BOARDLINK:
#   Windows: install LibreOffice and Python (tick "Add python.exe to
#            PATH"), then in Command Prompt:  pip install python-docx
# Leave the two settings below EMPTY: BOARDLINK finds both programs by
# itself, including LibreOffice's usual place on Windows. Fill one in
# only if a program was installed somewhere unusual, e.g.
#   SOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
PDF2WORD_PYTHON=
SOFFICE_BIN=
# How long one conversion may take before it is given up on.
WORD_CONVERT_TIMEOUT_MS=180000

